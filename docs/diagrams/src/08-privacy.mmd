flowchart TB
    subgraph ROLES["Who asks"]
        direction TB
        W["<b>Worker</b>"]:::worker
        SV["<b>Supervisor</b>"]:::sup
        HS["<b>HSE lead</b>"]:::hse
        CL["<b>Clinician or nurse</b>"]:::clin
        RV["<b>Reviewer</b>"]:::ext
    end
    subgraph STORES["What exists"]
        direction TB
        OPS["<b>Operational store</b><br/>plans · tasks · evidence"]:::store
        LBL["<b>Operational label only</b><br/>'clinic visit 14:00–16:00'"]:::ok
        CV["<b>Clinical vault</b><br/>results · referrals · care plans<br/>separate key and access path"]:::store
        AGG["<b>Aggregates only</b><br/>small groups and complements suppressed<br/>no ranking of workers"]:::hse
        AUD["<b>Audit log</b><br/>hash-chained · append-only"]:::store
    end
    W -->|"own record · consent · sees who looked"| CV
    W --> OPS
    SV --> OPS
    SV --> LBL
    SV -.->|"denied (403) and logged"| CV
    HS --> OPS
    HS -->|"copilot · Watch"| AGG
    CL --> CV
    CV -->|"minimal label"| LBL
    RV -->|"de-identified AI trace"| AUD
