flowchart TB
    subgraph PHONE["Phone or laptop · installable web app (PWA) · English and Arabic"]
        direction LR
        UI["<b>React 19 interface</b><br/>worker · site · clinic · HSE · Trust Centre"]:::sup
        DE["<b>Device policy engine</b><br/>TypeScript · same rules as the server"]:::engine
        LX["<b>Offline phrase matcher</b><br/>lexicon 1.1.0 · English and Arabic"]:::engine
        OB["<b>Offline outbox</b><br/>reports and alerts wait, then sync"]:::store
    end
    subgraph RUN["One container on Google Cloud Run · FastAPI /v1"]
        direction TB
        API["<b>API</b> · capability tokens · roles<br/>RFC 9457 errors · rate limits · 85 endpoints"]:::sup
        subgraph DET["Deterministic engines decide"]
            direction LR
            PE["<b>Policy engine</b><br/>signed heat-rule packs"]:::engine
            FC["<b>Foresee</b><br/>WBGT · 72-hour zone forecast"]:::engine
            PL["<b>Plan</b><br/>CP-SAT optimiser<br/>re-validation · certificate"]:::engine
            LG["<b>Protection ledger</b><br/>tasks · evidence E0–E4<br/>disputes · escalation"]:::engine
            WT["<b>Watch</b><br/>aggregate CUSUM signals"]:::engine
        end
        subgraph AIL["Bardan Intelligence proposes"]
            direction LR
            GD["<b>Bardan Guardian</b><br/>checks every draft"]:::ai
            AD["<b>Model adapter</b><br/>fallback · quotas · cache"]:::ai
            AG["<b>Bounded agents</b><br/>signed tools · budgets"]:::ai
        end
        subgraph DATA["Stores"]
            direction LR
            OPS["<b>Operational store</b><br/>plans · tasks · evidence"]:::store
            CLV["<b>Clinical vault</b><br/>separate key and path"]:::store
            CON["<b>Consent ledger</b>"]:::store
            AUD["<b>Audit log</b><br/>hash-chained"]:::store
        end
    end
    GEM["<b>Gemini API</b> · free tier<br/>optional · synthetic data only"]:::ext
    OM["<b>Open-Meteo</b><br/>live forecast · optional"]:::ext
    UI -->|"HTTPS /v1"| API
    OB -->|"sync when online"| API
    DE -.-|"same decisions · 49/49 replay"| PE
    API --> DET
    API --> AIL
    API --> DATA
    AG --> GD
    GD --> AD
    AD -.->|"optional"| GEM
    FC -.->|"live mode"| OM
