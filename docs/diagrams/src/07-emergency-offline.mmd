flowchart TB
    T(["<b>Emergency</b> tapped<br/>or urgent words heard"]):::danger --> C["<b>Emergency card opens at once</b><br/>on-device engine and cached content<br/>works with AI and internet off"]:::danger
    C --> S1["<b>Do this now</b><br/>stop work · call 998 · stay with the worker<br/>shade and cooling · no drinks if they cannot swallow"]:::danger
    C --> D["<b>Dialler opened</b><br/>mock in the prototype"]:::warn
    C --> Q["<b>Alert saved on this phone</b><br/>offline outbox · survives a reload"]:::store
    Q -->|"network returns"| SRV["<b>Received by the Bardan server</b><br/>a real receipt"]:::ok
    SRV --> ACK["<b>Seen by the site team</b><br/>only after someone presses 'I'm responding'"]:::ok
    ACK --> H["<b>Help received</b><br/>confirmed by the worker or a buddy"]:::ok
    C -.- N["<b>Never claims 'help is coming'</b><br/>each line turns on only when it is true"]:::warn
